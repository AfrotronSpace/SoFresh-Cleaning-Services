# So Fresh Cleaning Service — environment
#
#   cp .env.example .env
#
# Only DATABASE_URL, DIRECT_URL and AUTH_SECRET are required to boot. The site
# is designed to run with no email service, no WhatsApp API and no R2 bucket
# configured — each of those degrades to a visible, logged "skipped" state
# rather than breaking a booking.
#
# On Railway these go in the service's Variables tab. See docs/DEPLOYMENT.md
# for the full setup — database, Dockerfile, health check, migrations.

# ---------------------------------------------------------------- database
#
# The app runs as ONE persistent container on Railway (not per-request
# functions like Vercel), so pooling isn't required the way it was there —
# Prisma keeps its own small pool inside that one process.
#
# Using Railway's own Postgres plugin: both variables are the SAME value.
# Reference it with Railway's variable syntax so it stays in sync automatically:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   DIRECT_URL=${{Postgres.DATABASE_URL}}
#
# Using an external provider (Neon, Supabase) instead: use its pooled endpoint
# for DATABASE_URL and its direct endpoint for DIRECT_URL — migrations cannot
# run through a transaction-mode pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sofresh"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/sofresh"

# ---------------------------------------------------------------- required

# Signs the 30-day session cookie. Generate with:
#   openssl rand -base64 32
# Use a DIFFERENT value in production than in development.
AUTH_SECRET=""

# ---------------------------------------------------------------- site

# Absolute public origin, no trailing slash. Used for canonicals, OG tags, the
# sitemap and every link inside a notification email. Get this wrong and
# customers receive emails pointing at the wrong domain. Before a custom
# domain is attached, Railway's own generated domain works here too — it's
# exposed to the running container as RAILWAY_PUBLIC_DOMAIN if you'd rather
# reference that than hardcode it.
NEXT_PUBLIC_SITE_URL="https://sofreshcleaning.co.uk"

# Optional: the verification token from Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ---------------------------------------------------------------- seeding
# Read only by `npm run db:seed`. Without SEED_ADMIN_PASSWORD no admin account
# is created and /admin is unreachable.

SEED_ADMIN_EMAIL="info@sofreshcleaning.co.uk"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------- email (optional)
# Sent through Zoho CPaaS (formerly ZeptoMail) over its HTTPS API. Not SMTP:
# Railway blocks outbound SMTP below the Pro plan. With ZOHO_CPAAS_TOKEN
# unset, every email is written to MessageLog with status SKIPPED and the
# site carries on. Nothing is silently lost. Setup: docs/DEPLOYMENT.md.

# The Mail Agent's Send Mail token. Paste it with or without the leading
# "Zoho-enczapikey " — both work.
ZOHO_CPAAS_TOKEN=""
# Only needed if the Zoho account is NOT on the US data centre. Copy the
# exact URL from the Mail Agent's API setup page. Defaults to
# https://cpaas.zoho.com/v1.1/email
ZOHO_CPAAS_API_URL=""
# Must be an address on a domain verified in Zoho CPaaS.
# Defaults to "So Fresh Cleaning Service <info@sofreshcleaning.co.uk>".
EMAIL_FROM=""

# ---------------------------------------------------------------- whatsapp (optional)
# Leave both blank for the zero-setup mode: every booking produces a one-tap
# wa.me link in the dashboard. Set both to send automatically via Meta Cloud API.

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ---------------------------------------------------------------- r2 (optional)
# Cloudflare R2, for the customer photo/video uploads that AFT-F-02 I4 asks for.
# All four must be set together; with any missing, isR2Configured() is false and
# the site asks for photos on WhatsApp instead.
#
# The bucket must be PRIVATE — these are photographs of the inside of customers'
# homes. Uploads go browser → R2 directly via a presigned PUT (still the right
# call on Railway even without Vercel's 4.5 MB function-body limit forcing it —
# proxying customer video through your own container costs bandwidth and time
# for nothing), and the admin reads them back through short-lived presigned
# GET urls.
#
# Credentials: Cloudflare dashboard → R2 → Manage API tokens → Object Read & Write,
# scoped to this one bucket. The bucket also needs a CORS policy — see
# docs/DEPLOYMENT.md.

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sofresh-uploads"

# A SECOND bucket for genuinely public assets — service catalogue photos,
# never customer uploads. Enable the Public Development URL (or attach a
# custom domain) on THIS bucket only; the one above stays private forever.
# Reuses the same account/credentials — widen the API token's scope to cover
# both buckets, or issue a second token. With either this or the public host
# below unset, isR2PublicConfigured() is false and Admin → Services falls
# back to pasting an image path/URL by hand instead of uploading.
R2_PUBLIC_BUCKET="sofresh-public"

# The host that serves R2_PUBLIC_BUCKET: a custom domain
# (media.sofreshcleaning.co.uk) or a pub-<hash>.r2.dev development URL.
# Required for service-photo uploads to work; also whitelists the host for
# next/image. Never point this at R2_BUCKET.
NEXT_PUBLIC_R2_PUBLIC_HOST=""
